## Expand SPECS into full affix dictionaries keyed by id.
static func build_affixes() -> Dictionary:
	var out := {}
	for s: Dictionary in SPECS:
		var tiers: Array = []
		for i in 6:
			var v: Array = s["values"][i]
			var m := {"stat": s["stat"], "op": s["op"], "min": v[0], "max": v[1]}
			if v.size() >= 4:
				m["min2"] = v[2]
				m["max2"] = v[3]
			if s.has("decimals"):
				m["decimals"] = s["decimals"]
			tiers.append({"tier": i + 1, "ilvl": TIER_ILVLS[i], "name": s["names"][i], "mods": [m]})
		out[s["id"]] = {
			"id": s["id"],
			"kind": s["kind"],
			"group": s.get("group", s["id"]),
			"slot_types": (s["slot_types"] as Array).duplicate(),
			"tags": (s.get("tags", []) as Array).duplicate(),
			"weight": s.get("weight", 100),
			"two_handed_mult": s.get("two_handed_mult", 1.0),
			"tiers": tiers,
		}
	return out
